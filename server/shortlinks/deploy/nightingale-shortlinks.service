[Unit]
Description=NightingaleSilence Private Short Link Service
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/NightingaleSilenceWeb/NightingaleSilenceWebV2/current
Environment=PYTHONUNBUFFERED=1
Environment=NS_SHORTLINK_DB_PATH=/var/lib/nightingalesilence-v2/shortlinks/shortlinks.sqlite3
Environment=NS_SHORTLINK_PUBLIC_BASE_URL=https://nightingalesilence.com
Environment=NS_SHORTLINK_API_TOKEN_FILE=/run/credentials/nightingale-shortlinks.service/api-token
LoadCredential=api-token:/etc/nightingale-shortlinks/api-token
ExecStart=/www/wwwroot/NightingaleSilenceWeb/NightingaleSilenceWebV2/.venv/bin/gunicorn --workers 2 --bind 172.17.0.1:18768 --access-logfile - --error-logfile - 'server.shortlinks.app:create_app()'
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nightingalesilence-v2/shortlinks
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
