# NightingaleSilenceWebV2 环境变量说明（示例文件，不含任何真实密钥）。
# 复制为 .env.development.local / .env.production.local 后按需填写。

# ---- 前端构建开关（默认关闭；vite dev 会自动启用内部路由，无需手动设置）----
VITE_ENABLE_SILENCE=false
VITE_ENABLE_CONTENT_STUDIO=false
VITE_ENABLE_INTERNAL_ROUTES=false

# ---- 前端数据源 ----
# NSPlate 数据源：static-manifest（默认，静态 manifest + CDN）| legacy-api（旧 3456 服务回退）
VITE_NSPLATE_DATA_SOURCE=static-manifest
# NSPlate 静态 manifest 根路径
VITE_NSPLATE_MANIFEST_BASE=/data/plate
# Silence 本地版式 JSON 根路径（仅内部开发页使用）
VITE_SILENCE_LAYOUT_BASE=
# FFXIV 社区活动数据运行时 URL；为空时使用站内静态回退 /data/ffxiv/community-events.json
VITE_FFXIV_COMMUNITY_EVENTS_URL=
# Content Studio 内部工作台访问 token（仅本地内部编辑，不进公开构建）
VITE_CONTENT_STUDIO_TOKEN=

# ---- 开发代理（vite.config.ts 进程级读取，非 VITE_ 前缀，不会注入前端包）----
NSGLAMOUR_PROXY_PORT=8766
NSGLAMOUR_SNAPSHOT_PROXY_TARGET=https://nsffxiv.com
CONTENT_STUDIO_PORT=8770
ICON_COMPOSER_API_TOKEN=
NSPLATE_EXPORT_API_TOKEN=
