{
  "name": "nightingalesilence-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:glamour-api": "python server/glamour/app.py",
    "test:glamour-api": "python server/glamour/tests/run_tests.py",
    "test:shortlinks": "python -m unittest server.shortlinks.tests.test_shortlinks",
    "dev:content-studio": "node scripts/dev-content-studio.mjs",
    "test:content": "vitest run --config vitest.config.ts",
    "test:content-api": "node scripts/content/run-clean-python.mjs -- -m unittest discover server.content.tests",
    "build:content": "node scripts/content/build-public-content.mjs",
    "check:content": "node scripts/content/check-public-content.mjs && node scripts/content/check-local-boundary.mjs",
    "build:glamour-mapping": "python server/glamour/tools/build_item_mapping.py",
    "build:glamour-item-catalog": "python server/glamour/tools/build_item_catalog.py",
    "build:ffxiv-csv-structure": "node scripts/build-ffxiv-csv-structure.mjs",
    "build:fashion-check-history": "node scripts/fashion-check/build-history.mjs",
    "check:fashion-check-history": "node scripts/fashion-check/check-history.mjs",
    "build:fashion-check-tags": "node scripts/fashion-check/build-tag-database.mjs",
    "check:fashion-check-tags": "node scripts/fashion-check/check-tag-database.mjs",
    "check:fashion-check-current": "node scripts/fashion-check/check-current.mjs",
    "check:fashion-check-scope": "node scripts/fashion-check/check-scope.mjs",
    "check:deploy-completeness": "node scripts/check-deploy-completeness.mjs",
    "build:plate-manifest": "node scripts/build-nsplate-manifest.mjs --preview-img-base https://img.nightingalesilence.com/plate-preview-webp/256 --preview-max-edge 256 --preview-format webp",
    "build:plate-manifest:render": "node scripts/build-nsplate-manifest.mjs --preview-img-base https://img.nightingalesilence.com/plate-preview-webp/256 --preview-max-edge 256 --preview-format webp --render-img-base https://img.nightingalesilence.com/plate-render-webp/full --render-format webp",
    "build:plate-manifest:no-preview": "node scripts/build-nsplate-manifest.mjs",
    "build:plate-thumbnails": "node scripts/build-nsplate-thumbnails.mjs --format webp --quality 82",
    "refresh:plate-assets": "node scripts/build-nsplate-thumbnails.mjs --format webp --quality 82 --full-size --lossless --verify-exact --next-to-source",
    "check:plate-static": "node scripts/check-nsplate-static-manifest.mjs",
    "check:plate-static:preview": "node scripts/check-nsplate-static-manifest.mjs --expect-preview --check-preview-remote",
    "check:plate-static:render": "node scripts/check-nsplate-static-manifest.mjs --expect-preview --expect-render --check-remote --check-preview-remote --check-render-remote --check-cors",
    "check:plate-regression": "node scripts/check-nsplate-regression.mjs",
    "check:nsglamour-contract": "node scripts/check-nsglamour-contract.mjs",
    "check:release": "node scripts/check-release-readiness.mjs",
    "typecheck": "vue-tsc -b",
    "build": "vue-tsc -b && vite build",
    "check:i18n": "node scripts/check-ui-copy.mjs && node scripts/check-ui-locales.mjs",
    "check": "npm run typecheck && npm run check:i18n && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\""
  },
  "dependencies": {
    "@tiptap/extension-color": "^3.0.0",
    "@tiptap/extension-highlight": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-link": "^3.0.0",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-table-cell": "^3.0.0",
    "@tiptap/extension-table-header": "^3.0.0",
    "@tiptap/extension-table-row": "^3.0.0",
    "@tiptap/extension-text-align": "^3.0.0",
    "@tiptap/extension-text-style": "^3.0.0",
    "@tiptap/extension-underline": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@tiptap/vue-3": "^3.0.0",
    "pinia": "^2.1.7",
    "vis-timeline": "^8.5.2",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.3",
    "prettier": "^3.9.4",
    "typescript": "~5.7.3",
    "vite": "^6.2.4",
    "vitest": "^2.0.0",
    "vue-tsc": "^2.2.8"
  }
}
