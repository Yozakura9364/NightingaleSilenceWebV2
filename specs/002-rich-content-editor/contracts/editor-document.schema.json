{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nightingalesilence.com/schemas/content-document-v1.json",
  "title": "Nightingale Silence ContentDocument v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "doc"],
  "properties": {
    "schemaVersion": {
      "const": "content.document.v1"
    },
    "doc": {
      "$ref": "#/$defs/documentNode"
    }
  },
  "$defs": {
    "documentNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "doc" },
        "content": {
          "type": "array",
          "maxItems": 5000,
          "items": { "$ref": "#/$defs/blockNode" }
        }
      }
    },
    "blockNode": {
      "oneOf": [
        { "$ref": "#/$defs/paragraph" },
        { "$ref": "#/$defs/heading" },
        { "$ref": "#/$defs/blockquote" },
        { "$ref": "#/$defs/bulletList" },
        { "$ref": "#/$defs/orderedList" },
        { "$ref": "#/$defs/codeBlock" },
        { "$ref": "#/$defs/horizontalRule" },
        { "$ref": "#/$defs/table" },
        { "$ref": "#/$defs/image" },
        { "$ref": "#/$defs/gallery" },
        { "$ref": "#/$defs/collapse" }
      ]
    },
    "textAlignAttrs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "textAlign": {
          "enum": ["left", "center", "right", "justify"]
        }
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "paragraph" },
        "attrs": { "$ref": "#/$defs/textAlignAttrs" },
        "content": {
          "type": "array",
          "maxItems": 2000,
          "items": { "$ref": "#/$defs/inlineNode" }
        }
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs"],
      "properties": {
        "type": { "const": "heading" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level"],
          "properties": {
            "level": { "enum": [2, 3, 4] },
            "textAlign": { "enum": ["left", "center", "right", "justify"] }
          }
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/inlineNode" }
        }
      }
    },
    "blockquote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "blockquote" },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/blockNode" }
        }
      }
    },
    "bulletList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "bulletList" },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/listItem" }
        }
      }
    },
    "orderedList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "orderedList" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": { "type": "integer", "minimum": 1, "maximum": 9999 }
          }
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": { "$ref": "#/$defs/listItem" }
        }
      }
    },
    "listItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "listItem" },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/blockNode" }
        }
      }
    },
    "codeBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "codeBlock" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "language": {
              "type": ["string", "null"],
              "maxLength": 32,
              "pattern": "^[A-Za-z0-9_+.#-]*$"
            }
          }
        },
        "content": {
          "type": "array",
          "maxItems": 1,
          "items": { "$ref": "#/$defs/plainText" }
        }
      }
    },
    "horizontalRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "horizontalRule" }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "table" },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/tableRow" }
        }
      }
    },
    "tableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "tableRow" },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/tableCell" },
              { "$ref": "#/$defs/tableHeader" }
            ]
          }
        }
      }
    },
    "tableCellAttrs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colspan": { "type": "integer", "minimum": 1, "maximum": 50 },
        "rowspan": { "type": "integer", "minimum": 1, "maximum": 100 },
        "colwidth": {
          "type": ["array", "null"],
          "maxItems": 50,
          "items": { "type": "integer", "minimum": 25, "maximum": 4096 }
        },
        "textAlign": { "enum": ["left", "center", "right", "justify"] }
      }
    },
    "tableCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "tableCell" },
        "attrs": { "$ref": "#/$defs/tableCellAttrs" },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/blockNode" }
        }
      }
    },
    "tableHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "content"],
      "properties": {
        "type": { "const": "tableHeader" },
        "attrs": { "$ref": "#/$defs/tableCellAttrs" },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": { "$ref": "#/$defs/blockNode" }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs"],
      "properties": {
        "type": { "const": "image" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mediaId", "alt", "align", "displayWidth"],
          "properties": {
            "mediaId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "src": {
              "type": ["string", "null"],
              "maxLength": 2048,
              "pattern": "^(https://|media://)"
            },
            "alt": { "type": "string", "maxLength": 300 },
            "caption": { "type": ["string", "null"], "maxLength": 500 },
            "align": { "enum": ["left", "center", "right"] },
            "displayWidth": { "enum": [25, 50, 75, 100] },
            "width": { "type": ["integer", "null"], "minimum": 1, "maximum": 16384 },
            "height": { "type": ["integer", "null"], "minimum": 1, "maximum": 16384 }
          }
        }
      }
    },
    "gallery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs", "content"],
      "properties": {
        "type": { "const": "gallery" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["layout"],
          "properties": {
            "layout": { "enum": ["two-column", "three-column", "grid"] }
          }
        },
        "content": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/image" }
        }
      }
    },
    "collapse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs", "content"],
      "properties": {
        "type": { "const": "collapse" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title"],
          "properties": {
            "title": { "type": "string", "minLength": 1, "maxLength": 120 }
          }
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/blockNode" }
        }
      }
    },
    "inlineNode": {
      "oneOf": [
        { "$ref": "#/$defs/text" },
        { "$ref": "#/$defs/hardBreak" }
      ]
    },
    "plainText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string", "maxLength": 500000 }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string", "maxLength": 500000 },
        "marks": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/mark" }
        }
      }
    },
    "hardBreak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "hardBreak" }
      }
    },
    "mark": {
      "oneOf": [
        { "$ref": "#/$defs/simpleMark" },
        { "$ref": "#/$defs/textStyleMark" },
        { "$ref": "#/$defs/linkMark" }
      ]
    },
    "simpleMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["bold", "italic", "underline", "strike", "code"] }
      }
    },
    "textStyleMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs"],
      "properties": {
        "type": { "const": "textStyle" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": {
              "type": ["string", "null"],
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "sizePercent": {
              "type": ["integer", "null"],
              "enum": [null, 75, 100, 125, 150, 200]
            }
          }
        }
      }
    },
    "linkMark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "attrs"],
      "properties": {
        "type": { "const": "link" },
        "attrs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["href"],
          "properties": {
            "href": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^(https?://|mailto:|/(?!/)|#)"
            },
            "target": { "enum": [null, "_blank"] },
            "rel": { "enum": [null, "noopener noreferrer nofollow"] }
          }
        }
      }
    }
  }
}
